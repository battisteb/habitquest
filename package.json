{
  "name": "habitquest",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:bundle": "expo export --platform ios --platform android --platform web --output-dir .bundle-check",
    "export:web": "expo export --platform web --clear",
    "deploy:web": "npm run export:web && npx eas-cli@latest deploy --prod",
    "update:preview": "npx eas-cli@latest update --channel preview --platform all --non-interactive",
    "update:production": "npx eas-cli@latest update --channel production --platform all --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/dotgothic16": "^0.4.1",
    "@expo-google-fonts/jersey-10": "^0.4.1",
    "@legendapp/state": "3.0.0-beta.46",
    "@react-native-community/netinfo": "11.5.2",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.49.0",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.31",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.19",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-tracking-transparency": "~55.0.18",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "html2canvas": "^1.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-mobile-ads": "^16.3.2",
    "react-native-mmkv": "^3.2.0",
    "react-native-purchases": "^9.15.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "globals": "^14.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "prettier": "^3.5.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
